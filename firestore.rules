rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSavedMoment(data) {
      return data.title is string && data.title.size() <= 500 &&
             data.openingSentence is string && data.openingSentence.size() <= 2000 &&
             data.practicalActivity is string && data.practicalActivity.size() <= 5000;
    }

    match /savedMoments/{momentId} {
      allow read: if isValidId(momentId);
      allow create: if isValidId(momentId) && isValidSavedMoment(incoming());
      allow update: if isValidId(momentId) && isValidSavedMoment(incoming());
      allow delete: if isValidId(momentId);
    }
  }
}
